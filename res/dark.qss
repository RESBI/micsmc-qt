/* micsmc-qt 暗色主题 —— 呼应原版 micsmc-gui 的深色观感 */

QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: "Noto Sans CJK SC", "Segoe UI", system-ui, sans-serif;
}

QMainWindow, QScrollArea, QGroupBox QWidget {
    background-color: transparent;
}

QGroupBox {
    background-color: #161b22;
    border: 1px solid #2d333b;
    border-radius: 8px;
    margin-top: 10px;
    padding: 8px 10px 10px 10px;
    font-size: 13px;
    font-weight: 600;
    color: #8b949e;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QLabel[role="fieldlabel"] {
    color: #8b949e;
    font-size: 11px;
    font-weight: 400;
}

QLabel#bigval {
    font-size: 26px;
    font-weight: 600;
    color: #e6edf3;
}

QComboBox {
    background-color: #1c2129;
    border: 1px solid #2d333b;
    border-radius: 6px;
    padding: 4px 26px 4px 10px;
    color: #e6edf3;
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background-color: #1c2129;
    border: 1px solid #2d333b;
    selection-background-color: #264f78;
    selection-color: #ffffff;
    outline: none;
}

QPushButton {
    background-color: #21262d;
    border: 1px solid #2d333b;
    border-radius: 6px;
    padding: 7px 16px;
    color: #e6edf3;
}
QPushButton:hover { border-color: #4cc2ff; }
QPushButton:pressed { background-color: #2d333b; }

QTableWidget {
    background-color: #10151c;
    alternate-background-color: #131920;
    gridline-color: #2d333b;
    border: 1px solid #2d333b;
    border-radius: 6px;
    font-size: 12px;
}
QHeaderView::section {
    background-color: #161b22;
    color: #8b949e;
    border: none;
    border-bottom: 1px solid #2d333b;
    padding: 4px 6px;
    font-weight: 500;
}
QTableCornerButton::section { background-color: #161b22; border: none; }

QProgressBar {
    background-color: #1c2129;
    border: 1px solid #2d333b;
    border-radius: 7px;
    text-align: center;
    color: #e6edf3;
    font-size: 11px;
}
QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                      stop:0 #4cc2ff, stop:1 #7ee787);
    border-radius: 6px;
}

QStatusBar {
    background-color: #161b22;
    color: #8b949e;
    font-size: 12px;
}

QScrollBar:vertical {
    background: transparent; width: 10px; margin: 0;
}
QScrollBar::handle:vertical {
    background: #2d333b; border-radius: 5px; min-height: 30px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
